# Variable names only. Real credentials belong in ignored local .dev.vars or
# hosted server secrets. Never put credentials in frontend code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set AI_PROVIDER=gemini to use Gemini, or AI_PROVIDER=openai for OpenAI.

# Default for the VS Code package. Students register at /register.
# Create administrators privately with npm run admin:create.
AUTH_MODE=password

# Optional compatibility with the original Sites sign-in implementation:
# AUTH_MODE=chatgpt
# ADMIN_USER_ID=
