{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Careerly First time setup",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/setup-local.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Careerly Start website",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/run-framework.mjs",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Careerly Check backend",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/test-careerly.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Careerly Create admin account",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/admin-create.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Careerly Check accounts",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/test-auth.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
